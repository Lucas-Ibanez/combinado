# Ambiente de execução (development | production | test) — default: development
NODE_ENV=development

# Supabase (OBRIGATÓRIO — validado na inicialização)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM — usado pelo motor de risco (F6). Opcional agora.
ANTHROPIC_API_KEY=

# Canais de intervenção — usados pelo orquestrador (F9). Opcionais agora.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Vault — master key para envelope encryption das chaves do Baileys (T11.1)
# 64 hex chars (32 bytes). Obrigatório em produção.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_MASTER_KEY=

# Servidor HTTP para webhooks (T9.1)
WEBHOOK_PORT=3100
WEBHOOK_BASE_URL=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
